coffee:
  appName = "Luolita"
  greeting = "你好，萝莉塔！"
  items = ["CoffeeScript", "Pug", "Stylus"]
  version = "0.1.4"
  console.log "#{ appName } v#{ version }"
  console.log "编译了 #{ items.length } 个语法糖"

template:
  doctype html
  html(lang="zh-CN")
    head
      meta(charset="UTF-8")
      meta(name="viewport", content="width=device-width, initial-scale=1.0")
      title= appName
      link(rel="stylesheet", href=name + ".css")
    body
      .container
        h1= greeting
        .version v#{ version }
        ul.tech-list
          each item in items
            li= item
      script(src=name + ".js")

style:
  *
    box-sizing: border-box

  body
    margin: 0
    min-height: 100vh
    display: flex
    align-items: center
    justify-content: center
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%)
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif

  .container
    text-align: center
    padding: 2rem 3rem
    background: rgba(255, 255, 255, 0.95)
    border-radius: 16px
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3)

  h1
    margin: 0 0 0.5rem
    color: #333
    font-size: 2rem

  .version
    color: #888
    font-size: 0.9rem
    margin-bottom: 1.5rem

  .tech-list
    list-style: none
    padding: 0
    margin: 0

    li
      display: inline-block
      padding: 0.4rem 1rem
      margin: 0.3rem
      background: #667eea
      color: white
      border-radius: 20px
      font-size: 0.9rem
      transition: transform 0.2s
