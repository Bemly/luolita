coffee:
  title = Luolita
  githubUrl = 'https://github.com/bemly/luolita'
  f1Title = 'CoffeeScript'
  f2Title = 'Pug'
  f3Title = 'Stylus'

  cliExample = 'pnpm exec coffee luolita.coffee src/app.luoli -o dist/ -n app'
  browserExample = '''
    <link rel="luolita" href="app.luoli">
    <script src="luolita.browser.bundle.js"></script>

    <!-- 或使用 JS API -->
    <script>
     Luolita.renderToDOM(source, '#app')
    </script>
  '''

  coffeeSrc = '''
    # luoli 文件格式示例
    coffee:
      greeting = "Hello, Luolita!"
      items = ["CoffeeScript", "Pug", "Stylus"]

    template:
      h1= greeting
      ul
        each item in items
          li= item

    style:
      h1
        color: #6b9f93
        font-size: 2rem
      ul
        list-style: none
        padding: 0
      li
        display: inline-block
        margin: 0 0.5rem
  '''

template:
  div.page
    .bg-gradient
    nav.nav
      .nav-inner
        .nav-title= title
        .nav-links
          .nav-link(onclick="document.querySelector('.docs').scrollIntoView({behavior:'smooth'})") 使用指南
          a.nav-link(href=githubUrl, target="_blank", rel="noopener") GitHub

    section.hero
      h1= title
      p.tagline= '类似 Vue 的单文件组件生成器，零运行时依赖'
      p.desc= '将 .luoli 文件解析为三种语法糖：CoffeeScript、Pug 和 Stylus，分别编译为标准的 JavaScript、HTML 和 CSS。纯浏览器端编译，一个 &lt;script&gt; 标签即可使用。'
      .hero-actions
        .btn.btn-brand(onclick="document.querySelector('.docs').scrollIntoView({behavior:'smooth'})") 快速开始
        a.btn.btn-alt(href=githubUrl, target="_blank", rel="noopener") GitHub 仓库

    section.features
      .feature-card
        .icon!= '&#9749;'
        h3= f1Title
        p= 'CoffeeScript 编译为 JavaScript，自带源码映射，简洁优雅的语法输出。'
      .feature-card
        .icon!= '&#128054;'
        h3= f2Title
        p= 'Pug 模板编译为 HTML，CoffeeScript 变量自动桥接为模板 locals。'
      .feature-card
        .icon!= '&#127912;'
        h3= f3Title
        p= 'Stylus 编译为 CSS，支持嵌套、变量、混合等高级特性。'

    section.docs
      .docs-section
        h2 什么是 Luolita？
        p Luolita（萝莉塔）是一个类似 Vue 的单文件组件生成器。它将 <code>.luoli</code> 文件中的三种语法分别编译为标准的 JavaScript、HTML 和 CSS：
        ul
          li <code>coffee:</code> &mdash; CoffeeScript &rarr; JavaScript（含 source map）
          li <code>template:</code> &mdash; Pug 模板 &rarr; HTML（变量自动桥接）
          li <code>style:</code> &mdash; Stylus &rarr; CSS
        p 支持 Node.js 命令行和浏览器两种运行方式。

      .docs-section
        h2 Node.js 使用
        h3 安装
        .code-block
          code.
            $ pnpm add luolita
            # 或
            $ npm install luolita
        h3 命令行
        .code-block
          code!= cliExample
        h3 选项
        table.api-table
          thead
            tr
              th 选项
              th 说明
          tbody
            tr
              td <code>-o, --output</code>
              td 输出目录（默认 <code>temp/</code>）
            tr
              td <code>-n, --name</code>
              td 输出文件前缀
            tr
              td <code>-q, --quiet</code>
              td 关闭调试输出
            tr
              td <code>-h, --help</code>
              td 显示帮助信息
        h3 输出文件
        p 编译后生成三个文件：
        ul
          li <code>&lt;name&gt;.js</code> &mdash; JavaScript（含 source map）
          li <code>&lt;name&gt;.html</code> &mdash; HTML 模板
          li <code>&lt;name&gt;.css</code> &mdash; CSS 样式

      .docs-section
        h2 浏览器使用
        .code-block
          code!= browserExample
        p 浏览器 bundle 已内置 CoffeeScript、Pug、Stylus 运行时，零外部依赖。使用 <code>&lt;link rel=&quot;luolita&quot; href=&quot;...&quot;&gt;</code> 声明式加载，页面打开即渲染。
        h3 API
        table.api-table
          thead
            tr
              th 方法
              th 说明
          tbody
            tr
              td <code>Luolita.compile(text, opts)</code>
              td 编译 .luoli 文本，返回 Promise
            tr
              td <code>Luolita.renderToDOM(text, target)</code>
              td 编译并渲染到 DOM 元素

      .docs-section
        h2 .luoli 文件格式
        .code-block
          code!= coffeeSrc
        p 三个标记段均可选，省略某段则编译器输出空字符串。公共前导缩进会被自动去除。

      .docs-section
        h2 API 参考
        table.api-table
          thead
            tr
              th 方法
              th 参数
              th 返回
          tbody
            tr
              td <code>compile(text, opts)</code>
              td <code>text</code> 为 .luoli 内容，<code>opts</code> 含 <code>outputName</code>、<code>debug</code>
              td <code>Promise&#123; coffee: &#123;js, map&#125;, template, style &#125;</code>
            tr
              td <code>renderToDOM(text, target, opts)</code>
              td <code>target</code> 为 CSS 选择器或 DOM 元素
              td 将结果注入到页面

    footer.footer
      p Copyright &copy; Bemly_ &middot; WTFPL License

    script.
      document.querySelectorAll('.feature-card').forEach(function(card) {
        card.addEventListener('mousemove', function(e) {
          var r = card.getBoundingClientRect()
          card.style.setProperty('--mx', (e.clientX - r.left) + 'px')
          card.style.setProperty('--my', (e.clientY - r.top) + 'px')
        })
      })

style:
  :root
    --vp-c-white: #ffffff
    --vp-c-black: #000000
    --vp-c-gray-1: #dddde3
    --vp-c-gray-2: #e4e4e9
    --vp-c-gray-3: #ebebef
    --vp-c-gray-soft: rgba(142, 150, 170, .14)
    --vp-c-indigo-1: #3451b2
    --vp-c-indigo-2: #3a5ccc
    --vp-c-indigo-3: #5672cd
    --vp-c-indigo-soft: rgba(100, 108, 255, .14)
    --vp-c-green-1: #18794e
    --vp-c-green-2: #299764
    --vp-c-green-3: #30a46c
    --vp-c-green-soft: rgba(16, 185, 129, .14)
    --vp-c-yellow-1: #915930
    --vp-c-yellow-2: #946300
    --vp-c-yellow-3: #9f6a00
    --vp-c-yellow-soft: rgba(234, 179, 8, .14)
    --vp-c-red-1: #b8272c
    --vp-c-red-2: #d5393e
    --vp-c-red-3: #e0575b
    --vp-c-red-soft: rgba(244, 63, 94, .14)
    --vp-c-sponsor: #db2777
    --vp-c-bg: #ffffff
    --vp-c-bg-alt: #f6f6f7
    --vp-c-bg-elv: #ffffff
    --vp-c-bg-soft: #f6f6f7
    --vp-c-border: #c2c2c4
    --vp-c-divider: #e2e2e3
    --vp-c-gutter: #e2e2e3
    --vp-c-text-1: #3c3c43
    --vp-c-text-2: #67676c
    --vp-c-text-3: #929295
    --vp-c-default-1: var(--vp-c-gray-1)
    --vp-c-default-2: var(--vp-c-gray-2)
    --vp-c-default-3: var(--vp-c-gray-3)
    --vp-c-default-soft: var(--vp-c-gray-soft)
    --vp-c-brand-1: #6b9f93
    --vp-c-brand-2: #5a8a7e
    --vp-c-brand-3: #7aadad
    --vp-c-brand-soft: rgba(122, 173, 147, .14)
    --vp-c-brand: var(--vp-c-brand-1)
    --vp-c-tip-1: var(--vp-c-brand-1)
    --vp-c-tip-soft: var(--vp-c-brand-soft)
    --vp-c-warning-1: var(--vp-c-yellow-1)
    --vp-c-warning-soft: var(--vp-c-yellow-soft)
    --vp-c-danger-1: var(--vp-c-red-1)
    --vp-c-danger-soft: var(--vp-c-red-soft)
    --vp-font-family-base: "Inter", ui-sans-serif, system-ui, sans-serif, "Apple Color Emoji", "Segoe UI Emoji"
    --vp-font-family-mono: ui-monospace, "Menlo", "Monaco", "Consolas", "Liberation Mono", "Courier New", monospace
    --vp-shadow-2: 0 3px 12px rgba(0, 0, 0, .07), 0 1px 4px rgba(0, 0, 0, .07)
    --vp-shadow-3: 0 12px 32px rgba(0, 0, 0, .1), 0 2px 6px rgba(0, 0, 0, .08)
    --vp-layout-max-width: 1440px
    --vp-nav-height: 64px
    --vp-nav-bg-color: rgba(255, 255, 255, .8)
    --vp-home-hero-name-color: var(--vp-c-brand-1)
    --vp-home-hero-name-background: transparent
    --vp-button-brand-border: transparent
    --vp-button-brand-text: var(--vp-c-white)
    --vp-button-brand-bg: var(--vp-c-brand-3)
    --vp-button-brand-hover-border: transparent
    --vp-button-brand-hover-text: var(--vp-c-white)
    --vp-button-brand-hover-bg: var(--vp-c-brand-2)
    --vp-button-brand-active-border: transparent
    --vp-button-brand-active-text: var(--vp-c-white)
    --vp-button-brand-active-bg: var(--vp-c-brand-1)
    --vp-button-alt-border: transparent
    --vp-button-alt-text: var(--vp-c-text-1)
    --vp-button-alt-bg: var(--vp-c-default-3)
    --vp-button-alt-hover-border: transparent
    --vp-button-alt-hover-text: var(--vp-c-text-1)
    --vp-button-alt-hover-bg: var(--vp-c-default-2)
    --vp-button-alt-active-border: transparent
    --vp-button-alt-active-text: var(--vp-c-text-1)
    --vp-button-alt-active-bg: var(--vp-c-default-1)
    --vp-code-font-size: .875em
    --vp-code-color: var(--vp-c-brand-1)
    --vp-code-bg: var(--vp-c-default-soft)
    --vp-code-block-color: var(--vp-c-text-2)
    --vp-code-block-bg: var(--vp-c-bg-alt)
    --vp-code-block-divider-color: var(--vp-c-gutter)
    --vp-code-line-height: 1.7
    --vp-code-copy-code-border-color: var(--vp-c-divider)
    --vp-code-copy-code-bg: var(--vp-c-bg-soft)
    --vp-code-copy-code-hover-border-color: var(--vp-c-divider)
    --vp-code-copy-code-hover-bg: var(--vp-c-bg)
    --vp-footer-border-color: var(--vp-c-divider)
    --vp-c-bg-footer: rgba(255, 255, 255, .08)
    --vp-nav-bg: var(--vp-nav-bg-color)
    --vp-nav-border: var(--vp-c-divider)
    --vp-nav-title-color: var(--vp-c-text-1)
    --vp-nav-link-color: var(--vp-c-text-2)
    --vp-nav-link-hover-color: var(--vp-c-text-1)
    --vp-hero-padding-top: 96px
    --vp-hero-max-width: 1200px
    --vp-hero-heading-size: 3.2rem
    --vp-hero-tagline-size: 1.3rem
    --vp-hero-desc-size: 1rem
    --vp-hero-actions-gap: 16px
    --vp-features-gap: 24px
    --vp-docs-max-width: 800px
    --vp-docs-section-gap: 48px
    --vp-docs-heading-size: 1.75rem
    --vp-docs-subheading-size: 1.25rem
    --vp-docs-text-color: var(--vp-c-text-2)
    --vp-docs-border-color: var(--vp-c-divider)
    --vp-card-border-color: var(--vp-c-divider)
    --vp-card-bg: var(--vp-c-bg-elv)
    --vp-card-hover-border-color: var(--vp-c-brand-1)
    --vp-card-icon-size: 2rem
    --vp-card-title-size: 1.1rem
    --vp-card-desc-size: .9rem
    --vp-footer-text-color: var(--vp-c-text-3)
    --vp-footer-font-size: .875rem
    --vp-card-hover: rgba(122, 173, 147, .08)

  *
    margin: 0
    padding: 0
    box-sizing: border-box

  .page
    font-family: var(--vp-font-family-base)
    font-size: 16px
    font-weight: 400
    line-height: 24px
    color: var(--vp-c-text-1)
    background-color: var(--vp-c-bg)
    font-synthesis: style
    text-rendering: optimizeLegibility
    -webkit-font-smoothing: antialiased
    -moz-osx-font-smoothing: grayscale
    min-height: 100vh
    overflow-x: hidden
    position: relative

  a
    color: var(--vp-c-brand)
    text-decoration: none
    &:hover
      color: var(--vp-c-brand-2)

  // --- Navigation ---
  .nav
    position: sticky
    top: 0
    z-index: 30
    height: var(--vp-nav-height)
    background-color: var(--vp-nav-bg)
    border-bottom: 1px solid var(--vp-c-divider)
    backdrop-filter: blur(12px)

  .nav-inner
    max-width: var(--vp-layout-max-width)
    margin: 0 auto
    padding: 0 24px
    height: 100%
    display: flex
    align-items: center
    justify-content: space-between

  .nav-title
    font-size: 1.1rem
    font-weight: 700
    color: var(--vp-nav-title-color)

  .nav-links
    display: flex
    gap: 24px
    align-items: center

  .nav-link
    font-size: .875rem
    font-weight: 500
    color: var(--vp-nav-link-color)
    transition: color .2s
    cursor: pointer
    &:hover
      color: var(--vp-nav-link-hover-color)

  // --- Hero ---
  .hero
    max-width: var(--vp-hero-max-width)
    margin: 0 auto
    padding: var(--vp-hero-padding-top) 24px 64px
    text-align: center

  .hero h1
    font-size: var(--vp-hero-heading-size)
    font-weight: 700
    letter-spacing: -.02em
    line-height: 1.2
    background: linear-gradient(135deg, var(--vp-c-brand-1) 0%, var(--vp-c-brand-3) 100%)
    -webkit-background-clip: text
    -webkit-text-fill-color: transparent
    background-clip: text
    margin-bottom: 16px

  .hero .tagline
    font-size: var(--vp-hero-tagline-size)
    font-weight: 500
    color: var(--vp-c-text-2)
    margin-top: 12px

  .hero .desc
    max-width: 640px
    margin: 16px auto 32px
    color: var(--vp-c-text-2)
    font-size: var(--vp-hero-desc-size)

  .hero-actions
    display: flex
    gap: var(--vp-hero-actions-gap)
    justify-content: center

  .btn
    display: inline-block
    padding: 8px 28px
    border-radius: 24px
    font-size: .875rem
    font-weight: 600
    transition: background-color .2s, color .2s
    cursor: pointer
    border: 1px solid transparent
    line-height: 24px
    text-align: center

  .btn-brand
    background-color: var(--vp-button-brand-bg)
    color: var(--vp-button-brand-text)
    &:hover
      background-color: var(--vp-button-brand-hover-bg)
      color: var(--vp-button-brand-hover-text)

  .btn-alt
    background-color: var(--vp-button-alt-bg)
    color: var(--vp-button-alt-text)
    &:hover
      background-color: var(--vp-button-alt-hover-bg)

  // --- Features ---
  .features
    max-width: var(--vp-layout-max-width)
    margin: 0 auto
    padding: 0 24px 80px
    display: grid
    grid-template-columns: repeat(3, 1fr)
    gap: var(--vp-features-gap)

  .feature-card
    background-color: var(--vp-card-bg)
    border: 1px solid var(--vp-card-border-color)
    border-radius: 12px
    padding: 28px 24px
    transition: border-color .3s ease
    position: relative
    overflow: hidden
    &:hover
      border-color: var(--vp-card-hover-border-color)

  .feature-card .icon
    font-size: var(--vp-card-icon-size)
    margin-bottom: 8px
    display: inline-block

  .feature-card h3
    font-size: var(--vp-card-title-size)
    font-weight: 600
    color: var(--vp-c-text-1)
    margin-bottom: 6px

  .feature-card p
    font-size: var(--vp-card-desc-size)
    color: var(--vp-c-text-2)
    line-height: 1.6

  // --- Docs ---
  .docs
    max-width: var(--vp-docs-max-width)
    margin: 0 auto
    padding: 0 24px 80px

  .docs-section
    margin-bottom: var(--vp-docs-section-gap)

  .docs-section h2
    font-size: var(--vp-docs-heading-size)
    font-weight: 700
    color: var(--vp-c-text-1)
    margin-bottom: 16px
    padding-bottom: 8px
    border-bottom: 1px solid var(--vp-docs-border-color)
    letter-spacing: -.01em

  .docs-section h3
    font-size: var(--vp-docs-subheading-size)
    font-weight: 600
    color: var(--vp-c-text-1)
    margin: 24px 0 8px
    letter-spacing: -.01em

  .docs-section p
    color: var(--vp-docs-text-color)
    margin-bottom: 12px

  .docs-section ul
    color: var(--vp-docs-text-color)
    padding-left: 24px
    margin-bottom: 12px

  .docs-section ul li
    margin-bottom: 4px

  // --- Inline code ---
  code
    background-color: var(--vp-code-bg)
    color: var(--vp-code-color)
    padding: 2px 6px
    border-radius: 6px
    font-size: var(--vp-code-font-size)
    font-family: var(--vp-font-family-mono)

  // --- Code blocks ---
  .code-block
    background-color: var(--vp-code-block-bg)
    color: var(--vp-code-block-color)
    border-radius: 10px
    padding: 20px 24px
    margin: 16px 0
    overflow-x: auto
    font-family: var(--vp-font-family-mono)
    font-size: .85rem
    line-height: var(--vp-code-line-height)

  .code-block code
    background: none
    color: inherit
    padding: 0
    border-radius: 0
    font-size: inherit

  // --- API table ---
  .api-table
    width: 100%
    border-collapse: collapse
    margin: 12px 0

  .api-table th, .api-table td
    text-align: left
    padding: 8px 12px
    border-bottom: 1px solid var(--vp-docs-border-color)
    font-size: .875rem

  .api-table th
    color: var(--vp-c-text-1)
    font-weight: 600
    background-color: var(--vp-c-bg-soft)

  .api-table td
    color: var(--vp-c-text-2)

  // --- Footer ---
  .footer
    border-top: 1px solid var(--vp-footer-border-color)
    padding: 24px
    text-align: center
    color: var(--vp-footer-text-color)
    font-size: var(--vp-footer-font-size)

  // --- Responsive ---
  @media (max-width: 768px)
    .hero
      padding-top: 64px

    .hero h1
      font-size: 2.2rem

    .hero .tagline
      font-size: 1.1rem

    .features
      grid-template-columns: 1fr

    .hero-actions
      flex-direction: column
      align-items: center

    .nav-links
      gap: 16px

    .docs-section h2
      font-size: 1.5rem

    .docs-section h3
      font-size: 1.1rem
