{
  // 爱死 pnpm 惹，支持 JSON5 真是大好评！
  name: 'luolita',
  version: '0.1.4',
  // TODO: 目前 COFFEE 不支持 ESM 模块化，55555
  type: 'commonjs',
  main: 'luolita.mjs',
  browser: 'luolita.browser.coffee',
  bin: 'luolita.coffee',
  // 这是一个类似 Vue 的单文件组件生成器，将 ".luoli" 文件解析为 3 种语法糖：coffeescript、pug、stylus。
  description: 'A like-vue Single-File Components generator that parses HTML+CSS+JS ".luoli" into 3-Syntactic sugar: coffeescript, pug, and stylus. ',
  scripts: {
    // 把 README.md 编译为 luolita.mjs，适配 ESM 模式
    start: 'echo "[luolita] run ./luolita.coffee -h for usage"',
    test: 'pnpm exec coffee luolita.coffee',
    build: 'coffee -bl -c README.md && mv README.js luolita.mjs',
    readme: 'coffee -bl -c README.md && mv README.js luolita.mjs && node luolita.mjs',
    // 本地开发时构建 luolita.mjs（不影响 publish 流程）
    prepare: 'coffee -bl -c README.md && mv README.js luolita.mjs || true',
    // 清理生成的文件
    clean: 'rm -rf luolita.mjs temp/',
  },
  keywords: [
    'coffeescript',
    'generation',
    'parse',
    'tools',
    'pug',
    'jade',
    'stylus',
  ],
  author: 'Bemly_ <bemly_@petalmail.com> (https://bemly.moe)',
  contributors: [
    'thank you for everyone!',
  ],
  license: 'WTFPL',
  dependencies: {
    coffeescript: '^2.7.0',
    json5: '^2.2.3',
    minimist: '^1.2.8',
    pug: '^3.0.3',
    stylus: '^0.63.0',
  },
  config: {
    drink: 'coffee --bare --no-header --literate --output luolita.mjs --compile README.md',
    Windows: '[luolita] detected program work on Windows',
    Posix: '[luolita] detected program work on Posix',
  },
}
